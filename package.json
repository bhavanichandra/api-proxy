{
  "name": "api-proxy",
  "version": "1.0.0",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start-dev": "nodemon src/app.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "clean": "rimraf dist",
    "build": "bun run clean && bun run build:win && bun run build:linux && bun run build:macos",
    "build:win": "bun build src/app.js --compile --target=bun-windows-x64 --outfile=dist/api-proxy.exe",
    "build:linux": "bun build src/app.js --compile --target=bun-linux-x64 --outfile=dist/api-proxy-linux",
    "build:macos": "bun build src/app.js --compile --target=bun-darwin-arm64 --outfile=dist/api-proxy-macos"
  },
  "author": "Bhavani Chandra Vajapeyayaajula",
  "license": "MIT",
  "description": "",
  "dependencies": {
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "http-proxy-middleware": "^3.0.2",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "rimraf": "^5.0.7"
  }
}
